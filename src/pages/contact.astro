---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";

const email = "alghifarighazy508@gmail.com";
const socials = [
  { icon: "github", label: "GitHub", href: "https://github.com/ghazyAlghifari508", handle: "ghazyAlghifari508" },
  { icon: "linkedin", label: "LinkedIn", href: "https://www.linkedin.com/in/ghazy-alghifari-b81598386/", handle: "Ghazy Alghifari" },
  { icon: "instagram", label: "Instagram", href: "https://www.instagram.com/el_gh1farry/", handle: "@el_gh1farry" },
  { icon: "mail", label: "Email", href: `mailto:${email}`, handle: email },
] as const;
---

<BaseLayout
  title="Contact | Ghazy Nabil Alghifari"
  description="Contact Ghazy Nabil Alghifari for web development collaboration, full-stack projects, AI application ideas, or portfolio inquiries."
>
  <SectionHeading
    eyebrow="Let's connect"
    title="Contact"
    subtitle="Interested in collaborating, discussing a project, or learning more about my work? Send a message and I'll get back to you."
  />

  <div class="grid gap-8 md:grid-cols-[1fr_1.2fr]">
    <div data-reveal class="space-y-3">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-14 items-center gap-4 rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-card)] px-5 transition-colors hover:bg-[var(--surface-section)]"
          >
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-electric-lime text-near-black">
              <Icon name={s.icon} size={18} />
            </span>
            <span>
              <span class="block font-medium text-[var(--text-primary)]">{s.label}</span>
              <span class="block text-sm text-[var(--text-secondary)]">{s.handle}</span>
            </span>
          </a>
        ))
      }
    </div>

    <div
      data-reveal
      data-reveal-delay="90"
      class="flex flex-col justify-between rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-card)] p-6 sm:p-8 space-y-6"
    >
      <div class="space-y-3">
        <span class="inline-flex items-center gap-2 rounded-full bg-electric-lime/15 px-3 py-1 text-xs font-semibold text-near-black dark:text-electric-lime dark:bg-electric-lime/20">
          <span class="h-2 w-2 rounded-full bg-electric-lime animate-pulse"></span>
          Available for Opportunities
        </span>
        <h2 class="text-2xl font-medium text-[var(--text-primary)]">
          Let's talk directly
        </h2>
        <p class="leading-relaxed text-[var(--text-secondary)]">
          I am always open to discussing full-stack engineering roles, freelance projects, AI application ideas, or technical collaborations. Feel free to copy my email or send a direct message.
        </p>
      </div>

      <div class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-ground)] p-5">
        <p class="mb-2 text-xs font-medium uppercase tracking-wider text-[var(--text-secondary)]">
          Primary Email
        </p>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <span class="font-mono text-sm sm:text-base font-medium text-[var(--text-primary)] select-all">
            {email}
          </span>
          <div class="flex items-center gap-2">
            <button
              id="copy-email-btn"
              type="button"
              class="inline-flex h-10 items-center gap-1.5 rounded-[var(--radius-card)] bg-electric-lime px-4 text-xs font-medium text-near-black ring-1 ring-near-black transition-transform active:scale-95 hover:bg-[#aef03c]"
              aria-label="Copy email address"
            >
              <Icon name="copy" size={14} class="copy-icon" />
              <Icon name="check" size={14} class="check-icon hidden text-near-black" />
              <span class="copy-text">Copy Email</span>
            </button>
            <a
              href={`mailto:${email}`}
              class="inline-flex h-10 items-center gap-1.5 rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-card)] px-4 text-xs font-medium text-[var(--text-primary)] transition-colors hover:bg-[var(--surface-section)]"
            >
              <Icon name="send" size={13} />
              Open Mail
            </a>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 border-t border-[var(--border-subtle)] pt-5 text-sm">
        <div>
          <span class="block text-xs uppercase tracking-wider text-[var(--text-secondary)]">Location</span>
          <span class="mt-1 block font-medium text-[var(--text-primary)]">Bandung, Indonesia (UTC+7)</span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wider text-[var(--text-secondary)]">Response Time</span>
          <span class="mt-1 block font-medium text-[var(--text-primary)]">Within 24 Hours</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const copyBtn = document.getElementById("copy-email-btn");
  if (copyBtn) {
    copyBtn.addEventListener("click", async () => {
      const email = "alghifarighazy508@gmail.com";
      await navigator.clipboard.writeText(email);
      const copyIcon = copyBtn.querySelector(".copy-icon");
      const checkIcon = copyBtn.querySelector(".check-icon");
      const copyText = copyBtn.querySelector(".copy-text");

      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
      if (copyText) copyText.textContent = "Copied!";

      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
        if (copyText) copyText.textContent = "Copy Email";
      }, 2000);
    });
  }
</script>
