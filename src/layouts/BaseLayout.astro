---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const siteName = "Ghazy Nabil Alghifari";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const {
  title = "Ghazy Nabil Alghifari — Full-Stack Web Developer",
  description = "Portfolio of Ghazy Nabil Alghifari, a Bandung-based full-stack web developer building AI, SaaS, dashboard, and modern web applications.",
  image = "/foto_profile.webp",
  structuredData = [],
} = Astro.props;
const imageUrl = new URL(image, Astro.site);
const profileImageUrl = new URL("/foto_profile.webp", Astro.site);
const baseSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: siteName,
    url: new URL("/", Astro.site).href,
    image: profileImageUrl.href,
    jobTitle: "Full-Stack Web Developer",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Bandung",
      addressCountry: "ID",
    },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "Telkom University",
    },
    sameAs: [
      "https://github.com/ghazyAlghifari508",
      "https://www.linkedin.com/in/ghazy-alghifari-b81598386/",
      "https://www.instagram.com/el_gh1farry/",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: new URL("/", Astro.site).href,
    inLanguage: "en",
  },
];
const schema = [...baseSchema, ...(Array.isArray(structuredData) ? structuredData : [structuredData])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Preconnect for critical 3rd-party origins (PageSpeed optimization) -->
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <!-- Non-blocking font CSS (avoids render-blocking @import from CSS) -->
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800&display=swap"
      />
    </noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={imageUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="generator" content={Astro.generator} />
    {schema.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <!-- set theme + js flag + sidebar collapse before paint (no FOUC) -->
    <script is:inline>
      (() => {
        const t = localStorage.getItem("theme");
        const dark =
          t === "dark" ||
          (!t && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (dark) document.documentElement.classList.add("dark");
        document.documentElement.classList.add("js");
        if (localStorage.getItem("sidebar") === "collapsed") {
          document.documentElement.classList.add("sidebar-collapsed");
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-[var(--radius-card)] focus:bg-electric-lime focus:px-4 focus:py-2 focus:text-near-black"
      >Skip to content</a
    >
    <div class="lg:flex">
      <Sidebar />
      <main
        id="main"
        class="min-w-0 flex-1 px-5 py-10 sm:px-8 lg:px-12 lg:py-16"
      >
        <div class="mx-auto w-full max-w-[var(--page-max-width)]">
          <slot />
        </div>
      </main>
    </div>

    <script>
      // Scroll reveal: add .is-visible when [data-reveal] enters viewport.
      const els = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                const el = e.target as HTMLElement;
                const delay = el.dataset.revealDelay;
                if (delay) el.style.transitionDelay = `${delay}ms`;
                el.classList.add("is-visible");
                io.unobserve(el);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
